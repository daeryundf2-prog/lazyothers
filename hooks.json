{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "^(write_to_file|replace_file_content|generate_document|fill_form|apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|search_replace|SearchReplace|str_replace|StrReplace|ReplaceFileContent)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/markdown_structure_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyOthers: Markdown structure guard (스트리핑/빈 링크/표 불일치)",
						"failurePolicy": "FAIL_CLOSED"
					},
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/legal_factuality_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyOthers: Legal factuality guard (조문/판례 날조 검증)",
						"failurePolicy": "FAIL_CLOSED"
					}
				]
			},
			{
				"matcher": "^(bash|execute_command|run_command)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/markdown_structure_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyOthers: Markdown structure guard (bash 리다이렉트 쓰기 포함)",
						"failurePolicy": "FAIL_CLOSED"
					},
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/legal_factuality_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyOthers: Legal factuality guard (bash 리다이렉트 쓰기 포함)",
						"failurePolicy": "FAIL_CLOSED"
					}
				]
			}
		],
		"Stop": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/stop_claim_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyOthers: Stop claim guard (무근거 완료 선언 차단)"
					}
				]
			}
		],
		"SubagentStop": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/stop_claim_guard.mjs\"",
						"timeout": 5,
						"statusMessage": "LazyOthers: Stop claim guard (무근거 완료 선언 차단)"
					}
				]
			}
		]
	}
}
